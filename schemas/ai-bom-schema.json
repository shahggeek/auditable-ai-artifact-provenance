{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/ai-bom-1.0.schema.json",
  "title": "Artifact-level AI Bill of Materials",
  "description": "Candidate provenance record for one AI-generated development artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "artifact", "ai_components"],
  "properties": {
    "schema": { "const": "ai-bom/1.0" },
    "artifact": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "input_identifiers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "output_hash": { "$ref": "#/$defs/sha256" },
    "ai_components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "name", "version"],
        "properties": {
          "type": { "enum": ["model", "instruction", "tool", "context"] },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "hash": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "human_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "status", "date"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["approved", "changes-requested", "rejected"] },
        "date": { "type": "string", "format": "date" }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
